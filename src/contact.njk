<h1>contact</h1>
<p>Email is best. I read everything, though replies can be slow.</p>

{# Contact links are stored in _data/site.js #}
<dl class="contact">
{%- for link in site.links %}
  <dt>{{ link.label }}</dt>
  <dd><a href="{{ link.url }}">{{ link.text }}</a></dd>
{%- endfor %}
</dl>
